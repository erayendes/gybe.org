---
import BaseLayout from "../layouts/BaseLayout.astro";
import { albums } from "../data/albums";
import { members } from "../data/members";
import { crossingPaths } from "../data/crossingPaths";
import { shows } from "../data/shows";

const newest = albums[albums.length - 1];
const currentMembers = members.filter((member) => member.status === "current");
// Title and description follow the show list, so they stay true when dates change.
const buildDay = new Date().toISOString().slice(0, 10);
const upcomingDates = shows.dates.filter((show) => (show.endDate ?? show.date) >= buildDay);
const showYears = [...new Set(upcomingDates.map((show) => show.date.slice(0, 4)))];
const yearSpan = showYears.length > 1 ? `${showYears[0]}-${showYears[showYears.length - 1].slice(2)}` : showYears[0];
const showCountries = new Set(upcomingDates.map((show) => show.country)).size;
const homeTitle = yearSpan
  ? `GY!BE Tour Dates ${yearSpan}, Records & Members | gybe.org`
  : "GY!BE Records, Members & Live Dates | gybe.org";
const homeDescription = upcomingDates.length
  ? `Godspeed You! Black Emperor fan archive: ${upcomingDates.length} upcoming shows in ${showCountries} countries with ticket links, every record with track lists, and all members.`
  : "Godspeed You! Black Emperor fan archive: every record with track lists, live dates with ticket links, current and former members, and side projects.";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "gybe.org archive sections",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Discography", url: "https://gybe.org/disco" },
      { "@type": "ListItem", position: 2, name: "Shows", url: "https://gybe.org/shows" },
      { "@type": "ListItem", position: 3, name: "Members", url: "https://gybe.org/members" },
      { "@type": "ListItem", position: 4, name: "Crossing paths", url: "https://gybe.org/crossing-paths" },
    ],
  },
];
---

<BaseLayout
  title={homeTitle}
  description={homeDescription}
  structuredData={structuredData}
>
  <section class="hero">
    <div class="hero-copy">
      <h1 class="page-title hero-title">godspeed you!<br />black emperor</h1>
      <div class="hero-copy__body">
        <p class="deck">
          A source-minded fan archive for Godspeed You! Black Emperor: records, live dates, members, side projects, and the Montreal paths around them.
        </p>
        <div class="link-list" aria-label="Primary sections">
          <a href="/disco/">discography</a>
          <a href="/shows/">live dates</a>
          <a href="/members/">members</a>
          <a href="/crossing-paths/">crossing paths</a>
        </div>
      </div>
    </div>
    <figure class="image-frame">
      <img src="/images/site/live-stage.jpg" alt="Godspeed You! Black Emperor performing on a dark stage" width="1200" height="640" />
    </figure>
  </section>

  <div class="rule"></div>

  <section class="grid-two">
    <div>
      <p class="meta">latest record</p>
      <h2 class="section-title"><a href={`/disco/${newest.slug}/`}>{newest.title}</a></h2>
      <p>{newest.summary}</p>
    </div>
    <div>
      <p class="meta">live source / last checked {shows.lastChecked}</p>
      <h2 class="section-title"><a href="/shows/">current show list</a></h2>
      <p>
        Dates are copied from <a href={shows.sourceUrl} target="_blank" rel="noopener noreferrer">{shows.source}</a>, checked weekly and published automatically.
      </p>
      <div class="archive-list compact-list" aria-label="Current shows">
        {shows.dates.map((show) => (
          <div class="archive-row">
            <span class="meta">{show.displayDate}</span>
            <a class="archive-row__title" href={show.ticketUrl} target="_blank" rel="noopener noreferrer">{show.city}, {show.country}</a>
            <span class="archive-row__note">{show.venue}{show.soldOut && " (sold out)"}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <h2 class="section-title">index</h2>
    <div class="archive-list">
      <div class="archive-row">
        <span class="meta">{albums.length} entries</span>
        <a class="archive-row__title" href="/disco/">discography</a>
        <span class="archive-row__note">records, track lists, notes, official links</span>
      </div>
      <div class="archive-row">
        <span class="meta">{currentMembers.length} current</span>
        <a class="archive-row__title" href="/members/">members</a>
        <span class="archive-row__note">current and former members, including projectionists</span>
      </div>
      <div class="archive-row">
        <span class="meta">{crossingPaths.length} nodes</span>
        <a class="archive-row__title" href="/crossing-paths/">crossing-paths</a>
        <span class="archive-row__note">side projects and related artists</span>
      </div>
    </div>
  </section>
</BaseLayout>
