---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { crossingPaths, showsFor, upcomingShows } from "../../data/crossingPaths";
import { members } from "../../data/members";

export function getStaticPaths() {
  return crossingPaths.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const description = item.summary;
const pageUrl = `https://gybe.org/crossing-paths/${item.slug}/`;
const linkedMembers = members.filter((member) => item.members.includes(member.slug));
const tracked = showsFor(item);
const upcoming = upcomingShows(item);
const showDates = tracked && (upcoming.length > 0 || item.active?.endsWith("present"));
const groupRef = { "@type": "MusicGroup", "@id": `${pageUrl}#group`, name: item.title };
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "MusicGroup",
    "@id": groupRef["@id"],
    name: item.title,
    url: pageUrl,
    description: item.summary,
    ...(item.founded && { foundingDate: item.founded }),
    subjectOf: {
      "@type": "WebPage",
      url: pageUrl,
    },
    ...(linkedMembers.length > 0 && {
      member: linkedMembers.map((member) => ({
        "@type": "Person",
        name: member.name,
        url: `https://gybe.org/members/${member.slug}/`,
      })),
    }),
    sameAs: item.links.map((link) => link.url),
  },
  ...upcoming.map((show) => ({
    "@context": "https://schema.org",
    "@type": "MusicEvent",
    name: `${item.title} - ${show.city}`,
    startDate: show.date,
    endDate: show.date,
    description: `${item.title} live at ${show.venue} in ${show.city}, ${show.country}.`,
    url: show.ticketUrl,
    eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
    eventStatus: "https://schema.org/EventScheduled",
    performer: groupRef,
    offers: {
      "@type": "Offer",
      url: show.ticketUrl,
      ...(show.soldOut && { availability: "https://schema.org/SoldOut" }),
    },
    location: {
      "@type": "Place",
      name: show.venue,
      address: {
        "@type": "PostalAddress",
        addressLocality: show.city,
        addressCountry: show.country,
      },
    },
  })),
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://gybe.org/" },
      { "@type": "ListItem", position: 2, name: "Crossing paths", item: "https://gybe.org/crossing-paths/" },
      { "@type": "ListItem", position: 3, name: item.title, item: pageUrl },
    ],
  },
];
---

<BaseLayout title={`${item.title} | GY!BE Network`} description={description} structuredData={structuredData}>
  <article class="content">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">home</a>
      <span>/</span>
      <a href="/crossing-paths/">crossing-paths</a>
      <span>/</span>
      <span>{item.title}</span>
    </nav>
    <p class="meta">{item.relation}</p>
    <h1 class="page-title">{item.title}</h1>
    <p class="deck">{item.summary}</p>

    <h2>profile</h2>
    {item.body.map((paragraph) => <p>{paragraph}</p>)}

    {(item.founded || item.active || item.origin) && (
      <table class="status-table">
        <tbody>
          {item.origin && <tr><th>origin</th><td>{item.origin}</td></tr>}
          {item.founded && <tr><th>formed</th><td>{item.founded}</td></tr>}
          {item.active && <tr><th>active</th><td>{item.active}</td></tr>}
        </tbody>
      </table>
    )}

    {linkedMembers.length > 0 && (
      <>
        <h2>gy!be members</h2>
        <ul>
          {linkedMembers.map((member) => <li><a href={`/members/${member.slug}/`}>{member.name}</a> ({member.role})</li>)}
        </ul>
      </>
    )}

    {item.discography.length > 0 && (
      <>
        <h2>selected discography</h2>
        <ul>
          {item.discography.map((release) => <li>{release}</li>)}
        </ul>
      </>
    )}

    {tracked && showDates && (
      <>
        <h2>upcoming shows</h2>
        {upcoming.length > 0 ? (
          <table class="status-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>City</th>
                <th>Venue / festival</th>
                <th>Link</th>
              </tr>
            </thead>
            <tbody>
              {upcoming.map((show) => (
                <tr>
                  <td>{show.displayDate}</td>
                  <td>{show.city}, {show.country}</td>
                  <td>{show.venue}{show.soldOut && " (sold out)"}</td>
                  <td><a href={show.ticketUrl} target="_blank" rel="noopener noreferrer">ticket/source</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p>No upcoming dates were listed at the source when last checked.</p>
        )}
        <p class="side-note">
          Source: <a href={tracked.sourceUrl} target="_blank" rel="noopener noreferrer">{tracked.source}</a><br />
          Checked weekly; last checked {tracked.lastChecked}. Confirm dates with the official source before travelling.
        </p>
      </>
    )}

    {item.links.length > 0 && (
      <>
        <h2>links</h2>
        <div class="link-list">
          {item.links.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>)}
        </div>
      </>
    )}
  </article>
</BaseLayout>
